{
  "ServiceName": "mysterious-oppenheimer-service",
  "SourceConfiguration": {
    "ImageRepository": {
      "ImageIdentifier": "675254204326.dkr.ecr.ap-south-1.amazonaws.com/mysterious-oppenheimer:latest",
      "ImageRepositoryType": "ECR",
      "ImageConfiguration": {
        "Port": "3000",
        "RuntimeEnvironmentVariables": {
          "NODE_ENV": "production",
          "PORT": "3000"
        }
      }
    },
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::675254204326:role/AppRunnerECRAccessRole"
    },
    "AutoDeploymentsEnabled": true
  },
  "InstanceConfiguration": {
    "Cpu": "1 vCPU",
    "Memory": "2 GB"
  }
}
